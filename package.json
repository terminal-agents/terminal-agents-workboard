{
  "name": "terminal-agent-workboard",
  "version": "0.1.0",
  "description": "A tmux-backed terminal workboard for routing input across multiple code-agent sessions.",
  "type": "module",
  "bin": {
    "workboard": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^7.0.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
