{
  "name": "terminal-agents-workboard",
  "version": "0.0.1",
  "description": "A tmux-backed terminal workboard for routing input across multiple code-agent sessions (Claude Code, Codex, OpenCode, Gemini CLI).",
  "type": "module",
  "bin": {
    "workboard": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "!dist/testFixtures.js",
    "README.md",
    "LICENSE",
    ".agent-workboard.example.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tmux",
    "terminal",
    "agent",
    "claude",
    "codex",
    "opencode",
    "gemini",
    "ink",
    "react",
    "cli",
    "workboard"
  ],
  "author": "Lellansin <lellansin@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lellansin/terminal-agents-workboard.git"
  },
  "bugs": {
    "url": "https://github.com/Lellansin/terminal-agents-workboard/issues"
  },
  "homepage": "https://github.com/Lellansin/terminal-agents-workboard#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^7.0.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
